# Optional: prefills the Setup page on first run. Values saved on Setup live in
# api/config/settings.json (gitignored) and take precedence afterwards.
MONGODB_URI=
DB_NAME=demo
# voyage | openai
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_API_KEY=
# https://ai.mongodb.com (Atlas model API keys) or https://api.voyageai.com (Voyage keys)
VOYAGE_BASE_URL=https://ai.mongodb.com

# Integration tests (pytest -m atlas). Skipped if unset.
MONGODB_URI_TEST=
TEST_VOYAGE_KEY=
TEST_OPENAI_KEY=
